# MLSentry Environment Configuration
# Copy to .env and fill in values before running.

# === REQUIRED (fail-fast if missing at startup) ===
MLSENTRY_API_KEY=your-secret-api-key-here
DATABASE_URL=postgresql://mlsentry:mlsentry@localhost:5432/mlsentry

# === EXTERNAL INTEGRATIONS ===
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=your-ml-repo
GITHUB_WORKFLOW_ID=retrain.yml
MLFLOW_TRACKING_URI=http://localhost:5000

# === MONITORING CONFIGURATION ===
MONITORING_INTERVAL_MINUTES=15
LOG_ANOMALY_CONFIDENCE_THRESHOLD=0.85
DISTILBERT_CHECKPOINT=distilbert-base-uncased

# === TIMEOUT CONFIGURATION (ND-01, ND-03) ===
MLFLOW_TIMEOUT_MS=5000
GITHUB_API_TIMEOUT_MS=10000

# === APPLICATION ===
LOG_LEVEL=INFO
